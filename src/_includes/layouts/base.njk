<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% if title %}{{ title }} - Hagen Atelier{% else %}Hagen Atelier - An architecture practice, Copenhagen{% endif %}</title>
<meta name="description" content="Hagen Atelier - a small architecture practice in Copenhagen.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<link rel="stylesheet" href="/site.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
<div class="demo-banner">
	<a href="https://kuracms.com" target="_blank" rel="noreferrer">
		This is a demonstration site for kura - see how it works at kuracms.com &rarr;
	</a>
</div>

<header class="site">
	<a class="wordmark" href="/">hagen atelier</a>
	<nav>
		<a href="/projects/"{% if page.url.startsWith("/projects") %} class="is-active"{% endif %}>Projects</a>
		<a href="/about/"{% if page.url == "/about/" %} class="is-active"{% endif %}>About</a>
		<a href="/contact/"{% if page.url == "/contact/" %} class="is-active"{% endif %}>Contact</a>
	</nav>
</header>

{% if wide %}
<main class="wide">{{ content | safe }}</main>
{% else %}
<main>{{ content | safe }}</main>
{% endif %}

<footer class="site">
	<address class="addr">
		Stefansgade 35<br>
		2200 Kobenhavn N<br>
		<a href="mailto:hello@hagenatelier.example">hello@hagenatelier.example</a> &middot;
		<a href="mailto:office@hagenatelier.example">office@hagenatelier.example</a><br>
		+45 35 55 0188
	</address>
	<div class="legal">
		<a href="/privacy/">Privacy</a>
		<a href="https://kuracms.com" target="_blank" rel="noreferrer">Built with kura</a>
	</div>
</footer>
</body>
</html>
