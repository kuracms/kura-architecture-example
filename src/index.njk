---
layout: layouts/base.njk
permalink: /
---
{% set home =  globals | pageBySlug("home") %}
{% set recent = projects | recentProjects(3) %}

<h1>{{ home.title }}</h1>
{% if home.subtitle %}<p class="subtitle">{{ home.subtitle }}</p>{% endif %}

<div class="prose lede">
	{{ home.body | renderBody | safe }}
</div>

<section class="recent">
	<h2>Recent work</h2>
	<div class="recent-photos">
		{% for p in recent %}
		<a class="recent-photo" href="/projects/{{ p.slug }}/">
			{% if p.hero_image %}<img src="{{ p.hero_image }}" alt="{{ p.title }}" loading="lazy" />{% endif %}
			<div class="recent-photo-caption">
				<span class="recent-photo-name">{{ p.title }}</span>
				<span class="recent-photo-meta">{{ p.year }} &middot; {{ p.location }}</span>
			</div>
		</a>
		{% endfor %}
	</div>
	<a class="more-link" href="/projects/">All projects &rarr;</a>
</section>
